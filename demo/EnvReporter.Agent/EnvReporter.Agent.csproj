<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.16" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.23.0-preview.260928.1" />
    <PackageReference Include="Microsoft.Agents.AI.GitHub.Copilot" Version="1.23.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Foundry Hosted Agent mounts the per-session $HOME (/home/session) so that the default non-root
         'app' user cannot write to it, and the Copilot CLI fails with EACCES. Run as root like the
         official Foundry hosted agent Dockerfiles. -->
    <ContainerUser>root</ContainerUser>
  </PropertyGroup>

</Project>
